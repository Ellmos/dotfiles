#!/bin/sh

show_help() {
    echo "Usage: dockerReset [-i] [-n] [-v] [-r] [-h]"
    echo "Options:"
    echo "  -c    Remove all containers"
    echo "  -i    Remove all images"
    echo "  -n    Remove all networks"
    echo "  -v    Remove all volumes"
    echo "  -h    Show this help message"
    exit 0
}

REMOVE_CONTAINERS=false
REMOVE_IMAGES=false
REMOVE_NETWORKS=false
REMOVE_VOLUMES=false

while getopts "cinvh" opt; do
    case ${opt} in
    c) REMOVE_CONTAINERS=true ;;
    i) REMOVE_IMAGES=true ;;
    n) REMOVE_NETWORKS=true ;;
    v) REMOVE_VOLUMES=true ;;
    h) show_help ;;
    *) show_help ;;
    esac
done

# Stop all containers if any are present
CONTAINERS=$(docker ps -aq)
if [ -n "$CONTAINERS" ]; then
    echo "Stopping all containers..."
    docker stop $CONTAINERS
else
    echo "No containers to stop."
fi

# Remove containers if -r is passed
if [ "$REMOVE_CONTAINERS" = true ]; then
    if [ -n "$CONTAINERS" ]; then
        echo "Removing all containers..."
        docker rm $CONTAINERS
    else
        echo "No containers to remove."
    fi
fi

# Remove images if -i is passed
if [ "$REMOVE_IMAGES" = true ]; then
    IMAGES=$(docker images -q)
    if [ -n "$IMAGES" ]; then
        echo "Removing all images..."
        docker image prune --all --force
    else
        echo "No images to remove."
    fi
fi

# Remove networks if -n is passed
if [ "$REMOVE_NETWORKS" = true ]; then
    NETWORKS=$(docker network ls -q)
    if [ -n "$NETWORKS" ]; then
        echo "Removing all networks..."
        docker network prune --force
    else
        echo "No networks to remove."
    fi
fi

# Remove volumes if -v is passed
if [ "$REMOVE_VOLUMES" = true ]; then
    VOLUMES=$(docker volume ls -q)
    if [ -n "$VOLUMES" ]; then
        echo "Removing all volumes..."
        docker volume prune --all --force
    else
        echo "No volumes to remove."
    fi
fi
