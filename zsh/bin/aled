#!/bin/bash

# Check for at least one argument
if [ "$#" -lt 1 ]; then
    echo "Usage: $0 <repo_url> [directory_name]"
    exit 1
fi

REPO_URL="$1"
DIR_NAME="$2"

# If second argument is provided, use it as the directory name
if [ -n "$DIR_NAME" ]; then
    git clone "$REPO_URL" "$DIR_NAME" || exit 1
    cd "$DIR_NAME" || exit 1
else
    # Extract the default directory name from the repo URL
    BASENAME=$(basename "$REPO_URL" .git)
    git clone "$REPO_URL" || exit 1
    cd "$BASENAME" || exit 1
fi

