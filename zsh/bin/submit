#!/bin/sh

check_error() {
    if [ $? -ne 0 ]; then
        echo "$1"
        exit 1
    fi
}

if [ $# -ne 1 ]; then
    echo "one argument required"
    exit 1
fi

git tag -l | grep -q "$1"
if [ $? -eq 0 ]; then
    echo "tag $1 already exists"
    exit 1
fi

git status --porcelain | grep -q '^[AMRD]'
if [ $? -ne 0 ]; then
    echo "no changes to commit"
    exit 1
fi

git commit -m "$1"
check_error "failed to commit"

git tag -ma "$1"
check_error "failed to tag"

git push --follow-tags
check_error "failed to push tags"
