#!/bin/sh

usage() {
    echo "Usage: $(basename "$0") [-g glob] [-r regex] [-q] command [args...]" >&2
    echo "Run 'command' inside every subdirectory of the current directory." >&2
    echo "  -g glob   only run in directories whose name matches the glob pattern" >&2
    echo "  -r regex  only run in directories whose name matches the extended regex" >&2
    echo "  -q        quiet: don't print the directory name before running the command" >&2
    exit 1
}

glob=""
regex=""
quiet=0

while getopts "g:r:q" opt; do
    case "$opt" in
        g) glob="$OPTARG" ;;
        r) regex="$OPTARG" ;;
        q) quiet=1 ;;
        *) usage ;;
    esac
done
shift $((OPTIND - 1))

[ $# -eq 0 ] && usage
[ -n "$glob" ] && [ -n "$regex" ] && { echo "cannot use both -g and -r" >&2; exit 1; }

status=0

for dir in */; do
    [ -d "$dir" ] || continue
    name="${dir%/}"

    if [ -n "$glob" ]; then
        case "$name" in
            $glob) : ;;
            *) continue ;;
        esac
    fi

    if [ -n "$regex" ]; then
        echo "$name" | grep -qE "$regex" || continue
    fi

    [ "$quiet" -eq 1 ] || echo "==> $name <=="

    (cd "$dir" && "$@")
    rc=$?
    [ "$rc" -eq 0 ] || status=$rc
done

exit $status
